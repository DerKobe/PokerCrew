# Wird von deploy/setup.sh automatisch angelegt. Manuell: nach deploy/.env kopieren und anpassen.
# Eigene Domain oder – ohne Domain – <IP-mit-Bindestrichen>.sslip.io, z. B. 3-120-45-67.sslip.io
DOMAIN=poker.example.com

# Nur mit eigenem TURN-Server (docker compose --profile turn up -d):
# TURN_URL=turn:poker.example.com:3478?transport=udp,turn:poker.example.com:3478?transport=tcp
# TURN_USERNAME=poker
# TURN_PASSWORD=ein-langes-zufaelliges-passwort
# TURN_EXTERNAL_IP=<öffentliche-IP>/<private-IP>
