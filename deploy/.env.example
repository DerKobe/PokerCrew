# Created automatically by deploy/setup.sh. Manually: copy to deploy/.env and adjust.
# Your own domain or – without a domain – <IP-with-dashes>.sslip.io, e.g. 3-120-45-67.sslip.io
DOMAIN=poker.example.com

# Only with your own TURN server (docker compose --profile turn up -d):
# TURN_URL=turn:poker.example.com:3478?transport=udp,turn:poker.example.com:3478?transport=tcp
# TURN_USERNAME=poker
# TURN_PASSWORD=a-long-random-password
# TURN_EXTERNAL_IP=<public-IP>/<private-IP>
